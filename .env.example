HOST=127.0.0.1
PORT=4173
PUBLIC_ORIGIN=http://127.0.0.1:4173
# Na VPS atrás do Nginx: TRUST_PROXY=true e PUBLIC_ORIGIN=https://seu-dominio.
TRUST_PROXY=false
# Indexação exige também PUBLICATION_APPROVED=true. Em local/staging, manter false.
ROBOTS_INDEXING=false
SITEMAP_LASTMOD=2026-11-04
# Não ativar coleta antes de política e regulamento revisados + testes reais dos canais.
LEADS_ENABLED=false
PRIVACY_APPROVED=false
PRIVACY_VERSION=
PUBLICATION_APPROVED=false
# Chave base64 de 32 bytes. Gere localmente e armazene como segredo.
DATA_KEY=
DATA_DIR=./data
RESEND_API_KEY=
EMAIL_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE=
WHATSAPP_LANGUAGE=pt_BR
WHATSAPP_TO=5585985741485
# Texto completo aprovado em public/privacy.html antes de habilitar a coleta.
