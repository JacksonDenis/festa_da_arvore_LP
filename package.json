{
  "name": "festa-da-arvore-2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:security": "node --test tests/security.test.mjs",
    "check": "node --check server.mjs && node --check public/app.js && node --check src/leads.mjs && node --check src/providers.mjs",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run check && npm test && npm run build",
    "notifications": "node --env-file-if-exists=.env scripts/notifications.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
